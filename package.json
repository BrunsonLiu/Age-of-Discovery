{
  "name": "age-of-discovery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "esbuild test/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/logic.test.mjs --log-level=warning && node node_modules/.cache/logic.test.mjs",
    "test:e2e": "node test/e2e/voyage-smoke.mjs",
    "test:e2e:scenes": "node test/e2e/scene-survey.mjs && node test/e2e/scene-fallback-check.mjs && node test/e2e/scene-img-failed-reset.mjs",
    "test:e2e:audio": "node test/e2e/audio-live.mjs",
    "test:e2e:map": "node test/e2e/map-legibility.mjs",
    "test:e2e:map3d": "node test/e2e/map3d-check.mjs",
    "test:e2e:trade": "node test/e2e/trade-quote.mjs",
    "test:e2e:notify": "node test/e2e/notification-overlap.mjs",
    "test:e2e:mobile": "node test/e2e/mobile-layout.mjs",
    "test:e2e:clickable": "node test/e2e/clickable-audit.mjs",
    "test:e2e:clickable:1024": "node test/e2e/clickable-audit.mjs --vw=1024 --vh=768",
    "test:e2e:layout": "node test/e2e/layout-audit.mjs --widths=1024,1440",
    "test:e2e:mobile:prod": "node test/e2e/mobile-prod.mjs",
    "test:e2e:load": "node test/e2e/measure-map-load.mjs",
    "test:e2e:online": "node test/e2e/online-load-time.mjs",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:scenes && npm run test:e2e:audio && npm run test:e2e:map && npm run test:e2e:map3d && npm run test:e2e:trade && npm run test:e2e:notify && npm run test:e2e:mobile"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.186.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
