# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# WorkBuddy 发布用产物（base=/ 的根路径版本，供分享链接使用）
dist-wb
# 体积分析时的构建副本（vite.analyze.ts 产物，不是源码）
dist-analyze*/
# VITE_PROBE=1 的剖析用构建：要保留调试钩子、又要走生产代码路径时用
# （生产产物把这些钩子剥掉了，量不了；用 dist 会污染交付物）
dist-probe*/
# 本地量冷启动用的构建产物（dist 被占用时的替代目录）
dist-live*/
dist-boot/
# 从 public/ 退役的旧素材备份：留在本地便于回查，不进仓库
unused-assets/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# 代理工作区（诊断脚本/截图，不进仓库）
.workbuddy/
# WorkBuddy 发布标记文件（.wbapp_*.genie）：由发布工具生成，不该进代码仓库
.wbapp_*.genie
